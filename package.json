{
  "name": "glass-ds",
  "version": "0.0.0",
  "description": "A glassmorphism design system for React.",
  "keywords": [
    "react",
    "design-system",
    "glassmorphism",
    "components",
    "ui",
    "css-modules",
    "next.js",
    "react-server-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danteberishaj/glass-ds.git"
  },
  "homepage": "https://github.com/danteberishaj/glass-ds#readme",
  "bugs": "https://github.com/danteberishaj/glass-ds/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "import": "./dist/tokens/tokens.js",
      "default": "./dist/tokens/tokens.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/glass-ds.css"
    },
    "./tokens.css": {
      "types": "./dist/tokens-css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18",
      "onFail": "error"
    }
  },
  "browserslist": [
    "chrome >= 111",
    "safari >= 16.4",
    "firefox >= 128",
    "edge >= 111",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json && node scripts/finish-dist.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run tokens:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run test:package",
    "test:next": "bash scripts/test-next.sh",
    "test:package": "node scripts/check-package.ts",
    "prepublishOnly": "npm run verify && npm run test:next"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "globals": "^17.13.0",
    "jsdom": "^27.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
